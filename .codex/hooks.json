{
  "description": "Enforce llm-wiki lifecycle updater launches for Codex sessions.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"scripts/llm_wiki_agent_updater_hook.py\" --agent codex --workspace \".\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"scripts/llm_wiki_agent_updater_hook.py\" --agent codex --workspace \".\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"scripts/llm_wiki_agent_updater_hook.py\" --agent codex --workspace \".\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"scripts/llm_wiki_agent_updater_hook.py\" --agent codex --workspace \".\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
