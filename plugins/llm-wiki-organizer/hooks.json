{
  "description": "Optional llm-wiki updater hooks packaged with the plugin. Runtime support may require copying this to .codex/hooks.json.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"scripts/llm_wiki_agent_updater_hook.py\" --agent codex --workspace \".\"",
            "commandWindows": "python \"scripts\\llm_wiki_agent_updater_hook.py\" --agent codex --workspace \".\"",
            "statusMessage": "llm-wiki updater",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"scripts/llm_wiki_agent_updater_hook.py\" --agent codex --workspace \".\"",
            "commandWindows": "python \"scripts\\llm_wiki_agent_updater_hook.py\" --agent codex --workspace \".\"",
            "statusMessage": "llm-wiki updater",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"scripts/llm_wiki_agent_updater_hook.py\" --agent codex --workspace \".\"",
            "commandWindows": "python \"scripts\\llm_wiki_agent_updater_hook.py\" --agent codex --workspace \".\"",
            "statusMessage": "llm-wiki updater",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"scripts/llm_wiki_agent_updater_hook.py\" --agent codex --workspace \".\"",
            "commandWindows": "python \"scripts\\llm_wiki_agent_updater_hook.py\" --agent codex --workspace \".\"",
            "statusMessage": "llm-wiki updater",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
